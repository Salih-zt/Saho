rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the request is authenticated (either anonymous or provider-linked)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verify user owns the document record
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Users profile documents
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // 2. Caregiver contacts document collection
    match /caregiver_contacts/{contactId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 3. De-escalation recovery sessions document collection
    match /recovery_sessions/{sessionId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 4. Milestone recovery timeline entries collection
    match /timeline_entries/{entryId} {
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 5. Educational micro-cards progress tracking collection
    match /education_progress/{progressId} {
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
